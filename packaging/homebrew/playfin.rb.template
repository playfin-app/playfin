# Homebrew cask for Playfin (generated by scripts/update-cask.sh for each version).
cask "playfin" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/__OWNER__/__REPO__/releases/download/v#{version}/Playfin-macOS.zip"
  name "Playfin"
  desc "Native macOS client for Jellyfin (independent, not affiliated with the Jellyfin project)"
  homepage "https://github.com/__OWNER__/__REPO__"

  depends_on macos: ">= :sonoma"

  app "Playfin.app"

  # Unnotarised build (no Apple Developer account): we remove the quarantine so the app opens.
  postflight do
    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Playfin.app"]
  end

  zap trash: [
    "~/Library/Application Support/com.playfin.app",
    "~/Library/Caches/com.playfin.app",
    "~/Library/Preferences/com.playfin.app.plist",
  ]
end
